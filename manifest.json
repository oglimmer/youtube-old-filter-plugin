{
  "manifest_version": 3,
  "name": "YouTube Old Video Filter",
  "version": "1.0.1",
  "description": "Hides videos on the YouTube home feed that are older than a date you choose. Default: 4 weeks.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-old-filter@oglimmer.com",
      "update_url": "https://raw.githubusercontent.com/oglimmer/youtube-old-filter-plugin/main/updates.json",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "YouTube Old Video Filter",
    "default_popup": "options.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  }
}
